{
  "identifier": "default",
  "description": "Default capability for main and screenshot-overlay windows",
  "windows": ["main", "screenshot-overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-internal-toggle-devtools",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-message"
  ]
}
